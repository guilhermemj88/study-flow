# Opcional. Sem esta variável, os dados ficam em ./data.
STUDY_FLOW_DATA_DIR=./data

# O MCP escuta somente no computador local. O túnel HTTPS encaminha para esta porta.
MCP_HOST=127.0.0.1
MCP_PORT=3333

# URL HTTPS estável do túnel, sem /mcp. Descomente ao publicar.
# MCP_PUBLIC_URL=https://mcp.seudominio.com

# Mantenha false ao conectar o ChatGPT. Use true apenas com clientes OAuth locais.
MCP_ALLOW_INSECURE_DEV_REDIRECTS=false

# IA integrada: configuração global, somente no backend. A escolha de uso é por conta.
STUDY_FLOW_AI_ENABLED=false
STUDY_FLOW_AI_PROVIDER=openai_compatible
STUDY_FLOW_AI_BASE_URL=
STUDY_FLOW_AI_MODEL=
STUDY_FLOW_AI_API_KEY=
STUDY_FLOW_AI_TIMEOUT_MS=120000
# Extensões opcionais do provider; nunca aceitas pelas APIs do usuário.
STUDY_FLOW_AI_EXTRA_BODY_JSON={}
# DeepSeek: BASE_URL=https://api.deepseek.com, MODEL=deepseek-v4-flash
# Para chamadas curtas sem raciocínio adicional:
# STUDY_FLOW_AI_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}
