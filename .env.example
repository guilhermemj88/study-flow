# Find both values in Supabase Dashboard -> Connect -> App Frameworks -> Next.js.
# The publishable key is safe for browser use only because every personal table
# and Storage object is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
